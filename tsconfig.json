{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"rewriteRelativeImportExtensions": true,
		"allowImportingTsExtensions": true,
		"sourceMap": true,
		"strict": true,
		"paths": {
			"#lib": [
				"./src/lib"
			],
			"#lib/*": [
				"./src/lib/*"
			]
		}
	},
	"include": [
		"src",
		"vite.config.ts"
	],
	"exclude": [
		"src/service-worker"
	]
}
