# Tumblr API credentials — register an app at https://www.tumblr.com/oauth/apps
# Used server-side via `$app/env/private` (src/lib/server/clients.ts, src/lib/server/oauth.ts)
TUMBLR_CONSUMER_KEY=your_consumer_key_here
TUMBLR_CONSUMER_SECRET=your_consumer_secret_here
# Must match the callback URL registered on the Tumblr app exactly — including
# scheme and host. Tumblr rejects anything else with
# "Disallowed oauth_callback specified".
TUMBLR_CALLBACK_URL=https://your-tunnel.example.com/api/auth/callback
